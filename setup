#!/usr/bin/env bash
# Install all ideation skills for Claude Code
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$SCRIPT_DIR/skills"
TARGET_BASE="$HOME/.claude/skills"
SHARED_DIR="$HOME/.ideate"

SKILLS="ideate assumption premortem compare personas scope pivot ideate-start"

# Install shared files (VOICE.md, PROTOCOL.md)
mkdir -p "$SHARED_DIR"
for shared in VOICE.md PROTOCOL.md; do
  if [ "${1:-}" = "--copy" ]; then
    cp "$SCRIPT_DIR/$shared" "$SHARED_DIR/$shared"
  else
    ln -sf "$SCRIPT_DIR/$shared" "$SHARED_DIR/$shared"
  fi
done
echo "Installed shared files to $SHARED_DIR"

# Install skills
for skill in $SKILLS; do
  src="$SKILLS_DIR/$skill/SKILL.md"
  dest="$TARGET_BASE/$skill"

  if [ ! -f "$src" ]; then
    echo "WARN: $src not found, skipping"
    continue
  fi

  mkdir -p "$dest"

  if [ "${1:-}" = "--copy" ]; then
    cp "$src" "$dest/SKILL.md"
    echo "  Copied $skill"
  else
    ln -sf "$src" "$dest/SKILL.md"
    echo "  Linked $skill"
  fi
done

echo ""
echo "Installed 8 skills: $SKILLS"
echo ""
echo "Start a new Claude Code conversation and type:"
echo "  /ideate-start    — full validation cycle"
echo "  /ideate          — just idea validation"
echo "  /assumption      — hidden assumption check"
echo "  /premortem       — failure pre-mortem"
echo "  /compare         — competitive analysis"
echo "  /personas        — deep user persona"
echo "  /scope           — ruthless scoping"
echo "  /pivot           — pivot from a dead idea"
