#!/usr/bin/env bash
# Install /ideate as a Claude Code skill
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$HOME/.claude/skills/ideate"

mkdir -p "$SKILL_DIR"

# Symlink or copy based on flag
if [ "${1:-}" = "--copy" ]; then
  cp "$SCRIPT_DIR/SKILL.md" "$SKILL_DIR/SKILL.md"
  echo "Copied SKILL.md to $SKILL_DIR"
else
  ln -sf "$SCRIPT_DIR/SKILL.md" "$SKILL_DIR/SKILL.md"
  echo "Symlinked $SKILL_DIR/SKILL.md -> $SCRIPT_DIR/SKILL.md"
fi

echo ""
echo "Done. Start a new Claude Code conversation and type /ideate"
